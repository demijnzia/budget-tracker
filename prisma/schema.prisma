generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the running app
  directUrl = env("DIRECT_URL") // direct or session-pooler connection, used by `prisma db push`
}

enum TxType {
  EXPENSE
  INCOME
}

model Category {
  id           String        @id @default(cuid())
  name         String
  userId       String? // null = built-in category shared by everyone, otherwise owned by that user
  icon         String        @default("dot")
  color        String        @default("#3B6B4A")
  type         TxType        @default(EXPENSE)
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@unique([userId, name])
}

model Transaction {
  id         String   @id @default(cuid())
  amount     Int // stored in cents to avoid float rounding issues
  type       TxType
  note       String?
  userId     String // Supabase user id of the owner
  invoiceNo  String? // set for entries imported from e-invoices
  date       DateTime
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, invoiceNo])
  @@index([userId, date])
  @@index([categoryId])
}
