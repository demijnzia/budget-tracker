# Supabase: open your project and click "Connect" at the top.
# Replace [YOUR-PASSWORD] with your database password (Project Settings > Database).

# Used by the app. Transaction pooler, port 6543. Keep "?pgbouncer=true" on the end.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Used for `npx prisma db push`. Session pooler, port 5432 (works on networks without IPv6).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Used for sign-in. Project Settings > API: the Project URL and the "anon" / publishable key.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-OR-PUBLISHABLE-KEY]"
